# Hack Club Auth app: create one at https://auth.hackclub.com/developer/apps
# Redirect URI to register: <your site>/api/auth/callback  (e.g. http://localhost:3000/api/auth/callback)
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# Optional: public URL of the site, if it differs from the request origin (e.g. behind a proxy)
# APP_URL=https://tty.example.com

# Slack bot that adds people to #tty when they RSVP. Bot token scopes: channels:manage
# (or groups:write for a private channel). Invite the bot to the channel first.
SLACK_BOT_TOKEN=
# Channel ID of #tty (right-click the channel, Copy link, it is the part starting with C)
SLACK_CHANNEL_ID=

# Postgres for RSVPs (the table is created automatically)
DATABASE_URL=
